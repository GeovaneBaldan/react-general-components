    "lint": "pnpm exec biome lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.9.3"
  }
